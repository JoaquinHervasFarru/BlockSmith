{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockSmith",
  "version": "0.1.0",
  "identifier": "dev.blocksmith.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlockSmith",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 JoaquinHervasFarru. PolyForm Noncommercial 1.0.0",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Verificación y reconstrucción de directorios de disco",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
